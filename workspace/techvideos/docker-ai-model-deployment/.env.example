# Docker AI模型部署配置

# ============================================
# 模型配置
# ============================================

# 模型名称 (HuggingFace模型ID)
# 入门推荐: TinyLlama/TinyLlama-1.1B-Chat-v1.0
# 进阶推荐: meta-llama/Llama-2-7b-chat-hf
# 国产推荐: Qwen/Qwen2-7B-Instruct
MODEL_NAME=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# HuggingFace访问Token（私有模型需要）
# 从 https://huggingface.co/settings/tokens 获取
HF_TOKEN=

# ============================================
# 服务配置
# ============================================

# API端口
API_PORT=5000

# 日志级别 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# GPU配置
# ============================================

# 指定GPU (多GPU环境使用，如 "0" 或 "0,1")
CUDA_VISIBLE_DEVICES=0

# ============================================
# 模型下载镜像 (国内用户)
# ============================================

# 设置HuggingFace镜像站点
# HF_ENDPOINT=https://hf-mirror.com

# 或者使用代理
# HTTPS_PROXY=http://127.0.0.1:7890
